{
  "name": "shideh-agent",
  "displayName": "Shideh",
  "description": "Shideh BYOK model providers for the Agents window.",
  "version": "1.0.0",
  "publisher": "shideh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "chat.agent.enabled": true,
      "shideh.openAgentPanelOnStartup": false
    },
    "configuration": [
      {
        "title": "Shideh",
        "properties": {
          "shideh.openAgentPanelOnStartup": {
            "type": "boolean",
            "default": false,
            "description": "Open classic panel chat on startup (Agents window is the default shell)."
          },
          "shideh.opencodeGo.baseUrl": {
            "type": "string",
            "default": "https://opencode.ai/zen/go/v1",
            "description": "OpenCode Go API base URL."
          },
          "shideh.opencodeZen.baseUrl": {
            "type": "string",
            "default": "https://opencode.ai/zen/v1",
            "description": "OpenCode Zen API base URL."
          },
          "shideh.openrouter.baseUrl": {
            "type": "string",
            "default": "https://openrouter.ai/api/v1",
            "description": "OpenRouter API base URL."
          },
          "shideh.openai.baseUrl": {
            "type": "string",
            "default": "https://api.openai.com/v1",
            "description": "OpenAI API base URL."
          },
          "shideh.anthropic.baseUrl": {
            "type": "string",
            "default": "https://api.anthropic.com/v1",
            "description": "Anthropic API base URL."
          },
          "shideh.ollama.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:11434/v1",
            "description": "Ollama OpenAI-compatible base URL."
          },
          "shideh.openaiCompatible.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8080/v1",
            "description": "Custom OpenAI-compatible API base URL."
          },
          "shideh.deepseek.baseUrl": {
            "type": "string",
            "default": "https://api.deepseek.com/v1",
            "description": "DeepSeek API base URL (Deepseek Harness)."
          },
          "shideh.memory.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Inject Shideh memory into agent prompts."
          },
          "shideh.memory.framework": {
            "type": "string",
            "enum": ["mem0", "zep", "langmem", "cognee", "graphiti"],
            "default": "mem0",
            "description": "Memory framework adapter."
          }
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "shideh.agent",
        "name": "shideh",
        "fullName": "Shideh",
        "description": "Shideh coding agent",
        "isSticky": true,
        "isDefault": false,
        "locations": [
          "panel"
        ],
        "modes": [
          "agent"
        ]
      }
    ],
    "languageModelChatProviders": [
      { "vendor": "opencode-go", "displayName": "OpenCode Go" },
      { "vendor": "opencode-zen", "displayName": "OpenCode Zen" },
      { "vendor": "openrouter", "displayName": "OpenRouter" },
      { "vendor": "openai", "displayName": "OpenAI" },
      { "vendor": "anthropic", "displayName": "Anthropic" },
      { "vendor": "ollama", "displayName": "Ollama" },
      { "vendor": "openai-compatible", "displayName": "OpenAI Compatible" },
      { "vendor": "deepseek", "displayName": "DeepSeek" }
    ],
    "languageModelTools": [
      {
        "name": "shideh_readFile",
        "toolReferenceName": "readFile",
        "displayName": "Read file",
        "modelDescription": "Read a UTF-8 text file inside the open workspace.",
        "userDescription": "Read a file in the workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "description": "Workspace-relative path." }
          },
          "required": ["path"]
        }
      },
      {
        "name": "shideh_writeFile",
        "toolReferenceName": "writeFile",
        "displayName": "Edit file",
        "modelDescription": "Create or replace a UTF-8 text file inside the open workspace.",
        "userDescription": "Create or replace a file in the workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "description": "Workspace-relative path." },
            "content": { "type": "string", "description": "Full new file contents." }
          },
          "required": ["path", "content"]
        }
      },
      {
        "name": "shideh_listDirectory",
        "toolReferenceName": "listDirectory",
        "displayName": "List directory",
        "modelDescription": "List files and folders inside the open workspace.",
        "userDescription": "List a workspace directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "description": "Workspace-relative directory. Empty means the workspace root." }
          }
        }
      },
      {
        "name": "shideh_runTerminal",
        "toolReferenceName": "runTerminal",
        "displayName": "Run terminal command",
        "modelDescription": "Run a PowerShell command in the workspace after the user approves it.",
        "userDescription": "Run a terminal command after approval.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": { "type": "string", "description": "PowerShell command to run." }
          },
          "required": ["command"]
        }
      }
    ]
  }
}
