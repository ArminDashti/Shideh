{
	"$schema": "./component-explorer-config.schema.json",
	"screenshotDir": ".screenshots",
	"sessions": [
		{
			"name": "current"
		}
	],
	"redirection": {
		"port": 5337
	},
	"server": {
		"type": "http",
		"cmd": "npm run serve-out-rspack",
		"cwd": "../../",
		"wait": {
			"stdout": "http://localhost:(?<port>\\d+)/"
		},
		"url": "http://localhost:${var:port}"
	}
}
